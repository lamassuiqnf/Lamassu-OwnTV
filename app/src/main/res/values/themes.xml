<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Activity window theme. The real UI is pure Jetpack Compose (tv-material3); this framework
      theme only governs the launch window before Compose draws, so we keep it minimal and paint the
      window the brand background to avoid a flash. App default theme is AMOLED dark.
    -->
    <style name="Theme.OwnTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/owntv_window_bg</item>
        <item name="android:statusBarColor">@color/owntv_window_bg</item>
        <item name="android:navigationBarColor">@color/owntv_window_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Lamassu launch splash: navy + logo for every icon colour. -->
    <style name="Theme.OwnTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lamassu_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnTV</item>
    </style>
    <style name="Theme.OwnTV.Starting.Petrol" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Sunflower" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Cobalt" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Tomato" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Board" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Eggshell" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Olive" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.OliveCream" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Pixel" parent="Theme.OwnTV.Starting"/>
</resources>
