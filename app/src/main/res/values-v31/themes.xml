    <style name="Theme.OwnTV.Starting.Eggshell" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Olive" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.OliveCream" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Pixel" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Petrol.Still" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Sunflower.Still" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Cobalt.Still" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Tomato.Still" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Board.Still" parent="Theme.OwnTV.Starting"/>
