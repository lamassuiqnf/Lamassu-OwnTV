<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: Lamassu logo splash + brand strip for every launcher colour. -->
    <style name="Theme.OwnTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/owntv_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lamassu_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/lamassu_splash_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnTV</item>
    </style>
    <style name="Theme.OwnTV.Starting.Petrol" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Sunflower" parent="Theme.OwnTV.Starting"/>
    <style name="Theme.OwnTV.Starting.Cobalt" parent="Theme.OwnTV.Starting"/>
